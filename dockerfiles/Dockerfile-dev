# Docker-dev
FROM node:20-alpine

# Set environment variables
ENV NODE_ENV=dev
ENV PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true

WORKDIR /app

# 1. Install system packages, including NTP (openntpd)
RUN apk update && \
    apk add --no-cache openntpd tzdata && \
    cp /usr/share/zoneinfo/Europe/Stockholm /etc/localtime && \
    echo "EU" > /etc/timezone

# 2. Copy package files first for optimal caching
COPY package.json package-lock.json ./

# 3. Install all dependencies
RUN npm install

# 4. Install globally useful tools
RUN npm install -g ts-node nodemon typescript

# 5. Copy the whole project (not just schema)
COPY . .

# 6. Generate Prisma client
RUN npx prisma generate

# 7. Expose ports
EXPOSE 9229 8000

# 8. Always regenerate Prisma client on container start
CMD ["sh", "-c", "npx prisma generate && npm run dev"]