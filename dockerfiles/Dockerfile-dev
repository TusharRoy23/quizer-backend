FROM node:20-alpine

# Set environment variables
ENV NODE_ENV=dev
ENV PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true

WORKDIR /app

# 1. Install system packages, including NTP (openntpd)
RUN apk update && \
    apk add --no-cache openntpd tzdata && \
    cp /usr/share/zoneinfo/Europe/Stockholm /etc/localtime && \
    echo "EU" > /etc/timezone

# 2. Copy package files first for optimal caching
COPY package.json package-lock.json ./

# 3. Install all dependencies
RUN npm install

# 4. Install globally
RUN npm install -g ts-node nodemon typescript

# 5. Copy Prisma schema
COPY prisma/schema.prisma ./prisma/

# 6. Generate Prisma client (must happen before app code)
RUN npx prisma generate

# 7. Copy environment variables (for Supabase connection)
COPY .envs/.local/.env ./.env

# 8. Copy the rest of the application
COPY . .

EXPOSE 9229 8000
CMD ["npm", "run", "start:watch"]